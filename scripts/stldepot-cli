#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${STLDEPOT_DIR:-/opt/stldepot}"

run_as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "Fehler: Dieser Befehl benötigt root-Rechte. Bitte als root ausführen." >&2
    exit 1
  fi
}

case "${1:-}" in
  update)
    if [[ ! -f "$APP_DIR/update.sh" ]]; then
      echo "Fehler: $APP_DIR/update.sh wurde nicht gefunden." >&2
      exit 1
    fi
    exec bash "$APP_DIR/update.sh"
    ;;
  restart)
    run_as_root systemctl restart stldepot.service
    ;;
  status)
    run_as_root systemctl status stldepot.service
    ;;
  logs)
    run_as_root journalctl -u stldepot.service -f
    ;;
  *)
    echo "Verwendung: stldepot {update|restart|status|logs}"
    exit 1
    ;;
esac

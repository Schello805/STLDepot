{
  "name": "stl-storage",
  "version": "1.0.0",
  "description": "Moderner Open-Source 3D-Druck-Katalog für STL und 3MF Dateien mit 3D-WebGL-Vorschau und Slicer-Integration",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prebuild": "node scripts/update-revision.js",
    "build": "npm run build --prefix client",
    "start": "npm run build && node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "stl",
    "3mf",
    "3d-printing",
    "threejs",
    "catalog",
    "slicer",
    "bambu-studio",
    "orcaslicer",
    "prusaslicer"
  ],
  "author": "Michael Schellenberger",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  }
}
